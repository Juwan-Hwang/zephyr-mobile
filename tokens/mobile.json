{
  "$description": "移动端增补层：只放手机特有的值，不覆盖桌面 token。桌面来源 vendor/zephyr/packages/tokens/src/*.json（只读）。value = 深色默认，lightValue = 浅色覆盖。",
  "touch": {
    "min-ios":     { "value": "44px", "comment": "HIG 最小触控" },
    "min-android": { "value": "48px", "comment": "Material 最小触控" }
  },
  "type": {
    "caption":   { "size": { "value": "12px" }, "weight": { "value": "400" }, "line": { "value": "16px" } },
    "footnote":  { "size": { "value": "13px" }, "weight": { "value": "400" }, "line": { "value": "18px" } },
    "button":    { "size": { "value": "15px" }, "weight": { "value": "600" }, "line": { "value": "20px" }, "comment": "桌面按钮 10px 全大写，手机改 15pt 正常大小写" },
    "body":      { "size": { "value": "16px" }, "weight": { "value": "400" }, "line": { "value": "22px" } },
    "headline":  { "size": { "value": "17px" }, "weight": { "value": "600" }, "line": { "value": "22px" } },
    "title":     { "size": { "value": "22px" }, "weight": { "value": "600" }, "line": { "value": "28px" } },
    "large":     { "size": { "value": "34px" }, "weight": { "value": "700" }, "line": { "value": "41px" } },
    "metric":    { "size": { "value": "40px" }, "weight": { "value": "200" }, "line": { "value": "44px" }, "comment": "速率/延迟大数字：细字重 + 等宽数字" },
    "metric-sm": { "size": { "value": "22px" }, "weight": { "value": "300" }, "line": { "value": "26px" } }
  },
  "layout": {
    "row-height":       { "value": "52px", "comment": "节点虚拟列表固定行高（与原型 RH=52 一致，10^8 行必须固定）" },
    "section-header":   { "value": "32px" },
    "tabbar-height":    { "value": "56px" },
    "page-margin":      { "value": "16px" },
    "card-gap":         { "value": "12px" },
    "sheet-radius":     { "value": "34px", "comment": "原型 sheet 圆角 34" },
    "connect-button":   { "value": "168px", "comment": "首页 ZConnectButton 直径" },
    "index-rail-width": { "value": "20px", "comment": "节点页右侧地区索引条" }
  },
  "motion": {
    "spring-response": { "value": "0.42", "comment": "SwiftUI spring(response:) / Compose stiffness 换算见生成代码" },
    "spring-damping":  { "value": "0.82" },
    "press-scale":     { "value": "0.97" },
    "settle-delay":    { "value": "400ms", "comment": "滚动停止后测可见行延迟" },
    "undo-window":     { "value": "4s",    "comment": "\"已换到 东京 03 · 撤销\" 吐司停留" }
  },
  "latency": {
    "$comment": "按原型（克制）：< 200ms 中性次级灰，>= 200ms 琥珀，超时红，未测更淡。不再用红黄绿四档。",
    "normal":  { "value": "rgba(255, 255, 255, 0.6)", "lightValue": "rgba(0, 0, 0, 0.58)", "comment": "< 200ms（= screen.t2）" },
    "slow":    { "value": "#FFD60A", "lightValue": "#FF9F0A", "comment": ">= 200ms（= screen.amber）" },
    "timeout": { "value": "#FF453A", "lightValue": "#FF3B30", "comment": "超时 -1（= screen.red）" },
    "unknown": { "value": "rgba(255, 255, 255, 0.4)", "lightValue": "rgba(0, 0, 0, 0.4)", "comment": "未测（= screen.t3）" },
    "threshold-slow": { "value": "200" }
  },
  "screen": {
    "$comment": "手机页面实色表面（原型 design/prototype/index.html :root / .device.light）。桌面 bg/surface 是半透明玻璃，手机不用。",
    "bg":     { "value": "#000000", "lightValue": "#F2F2F7" },
    "s1":     { "value": "#0C0C0E", "lightValue": "#FFFFFF", "comment": "卡片" },
    "s2":     { "value": "#141417", "lightValue": "#FFFFFF", "comment": "卡片内嵌 / 列表" },
    "s3":     { "value": "#1D1D21", "lightValue": "#E9E9EE", "comment": "控件底" },
    "s4":     { "value": "#26262B", "lightValue": "#DCDCE1", "comment": "按下 / 分段选中" },
    "hl":     { "value": "rgba(255, 255, 255, 0.075)", "lightValue": "rgba(0, 0, 0, 0.07)", "comment": "细分隔线" },
    "hl2":    { "value": "rgba(255, 255, 255, 0.13)", "lightValue": "rgba(0, 0, 0, 0.12)", "comment": "描边" },
    "t1":     { "value": "rgba(255, 255, 255, 0.95)", "lightValue": "rgba(0, 0, 0, 0.9)" },
    "t2":     { "value": "rgba(255, 255, 255, 0.6)", "lightValue": "rgba(0, 0, 0, 0.58)" },
    "t3":     { "value": "rgba(255, 255, 255, 0.4)", "lightValue": "rgba(0, 0, 0, 0.4)" },
    "t4":     { "value": "rgba(255, 255, 255, 0.2)", "lightValue": "rgba(0, 0, 0, 0.18)" },
    "green":  { "value": "#30D158", "lightValue": "#34C759" },
    "amber":  { "value": "#FFD60A", "lightValue": "#FF9F0A" },
    "amber-a":{ "value": "rgba(255, 214, 10, 0.12)", "lightValue": "rgba(255, 159, 10, 0.12)" },
    "red":    { "value": "#FF453A", "lightValue": "#FF3B30" },
    "up":     { "value": "#FF6B6B", "lightValue": "#FF5E57", "comment": "上行速率" },
    "glass":  { "value": "rgba(28, 28, 32, 0.82)", "lightValue": "rgba(255, 255, 255, 0.82)", "comment": "浮层/底栏玻璃底色（叠系统模糊）" },
    "cmd-bg": { "value": "rgba(0, 0, 0, 0.72)", "lightValue": "rgba(242, 242, 247, 0.8)", "comment": "指令栏" },
    "fade":   { "value": "#000000", "lightValue": "#F2F2F7", "comment": "列表上下渐隐终点" },
    "primary":    { "value": "#F2F2F2", "lightValue": "#000000", "comment": "主按钮底（原型深色 #F2F2F2 黑字）" },
    "on-primary": { "value": "#000000", "lightValue": "#FFFFFF" },
    "pressed":    { "value": "rgba(255, 255, 255, 0.03)", "lightValue": "rgba(0, 0, 0, 0.03)", "comment": "行按下" }
  },
  "glow": {
    "connect": { "value": "28px", "comment": "已连接时强调色光晕半径" },
    "alpha":   { "value": "0.35" }
  }
}
