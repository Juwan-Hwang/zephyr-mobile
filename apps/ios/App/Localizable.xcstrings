    "订阅、节点与流量数据仅保存在此设备上。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزَّن الاشتراكات والعقد وبيانات الاستخدام على هذا الجهاز فقط."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions, nodes, and traffic data are stored only on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones, los nodos y los datos de tráfico solo se guardan en este dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشتراک‌ها، نودها و داده‌های ترافیک فقط روی این دستگاه ذخیره می‌شوند."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプション、ノード、トラフィックのデータは、このデバイスにのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독, 노드 및 트래픽 데이터는 이 기기에만 저장됩니다."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စာရင်းသွင်းမှု၊ နုဒ်နှင့် ဒေတာ အသုံးပြုမှုကို ဤစက်တွင်သာ သိမ်းသည်။"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписки, узлы и данные о трафике хранятся только на этом устройстве."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usajili, nodi na data ya trafiki huhifadhiwa kwenye kifaa hiki pekee."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abunalar, düwünler we trafik maglumatlary diňe şu enjamda saklanýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelikler, düğümler ve trafik verileri yalnızca bu cihazda saklanır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبسکرپشنز، نوڈز اور ٹریفک ڈیٹا صرف اسی ڈیوائس پر محفوظ ہوتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng ký, nút và dữ liệu lưu lượng chỉ được lưu trên thiết bị này."
          }
        }
      }
    },
