        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လော့ခ်မျက်နှာပြင်ကို ဖိထားပါ › စိတ်ကြိုက်ပြင်ရန် › လော့ခ်မျက်နှာပြင် › ဝစ်ဂျက် ထည့်ရန် › Zephyr။ ချိတ်ဆက်ထားစဉ် Live Activity ပေါ်မည်။"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь экрана блокировки и удерживайте › «Настроить» › «Экран блокировки» › «Добавить виджеты» › Zephyr. Во время подключения отображается «Живая активность»."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gusa na ushikilie Skrini Iliyofungwa › Weka Mapendeleo › Skrini Iliyofungwa › Ongeza Wijeti › Zephyr. Shughuli ya Moja kwa Moja huonekana ukiwa umeunganishwa."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gulp ekranyna basyp saklaň › Sazla › Gulp ekrany › Widjet goş › Zephyr. Birikdirilende Janly işjeňlik görünýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitli Ekran’a dokunup basılı tutun › Özelleştir › Kilitli Ekran › Widget Ekle › Zephyr. Bağlıyken bir Canlı Etkinlik görünür."
          }
