    "未随包附带许可文件，许可依据其清单或仓库。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتضمن الحزمة ملف ترخيص؛ والترخيص مأخوذ من ملف البيان أو المستودع الخاص بها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No license file is included in the package; the license is taken from its manifest or repository."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paquete no incluye archivo de licencia; la licencia se toma de su manifiesto o repositorio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فایل مجوز همراه بسته نیست؛ مجوز بر اساس مانیفست یا مخزن آن است."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パッケージにライセンスファイルが含まれていないため、マニフェストまたはリポジトリに記載のライセンスに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패키지에 라이선스 파일이 포함되어 있지 않아 매니페스트 또는 저장소에 명시된 라이선스를 따릅니다."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပက်ကေ့ဂျ်တွင် လိုင်စင်ဖိုင် မပါဝင်ပါ။ လိုင်စင်ကို ၎င်း၏ manifest သို့မဟုတ် repository အရ သတ်မှတ်ပါသည်။"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл лицензии в пакет не входит; лицензия указана в его манифесте или репозитории."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kifurushi hakina faili ya leseni; leseni imechukuliwa kutoka kwa manifesti au hazina yake."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bukja ygtyýarnama faýly goşulmandyr; ygtyýarnama onuň manifestine ýa-da ammaryna görä."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakette lisans dosyası yok; lisans, paketin bildiriminden (manifest) veya deposundan alınmıştır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیکیج میں لائسنس فائل شامل نہیں؛ لائسنس اس کے manifest یا ریپوزٹری کے مطابق ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói không kèm tệp giấy phép; giấy phép được lấy theo tệp kê khai hoặc kho mã của gói."
          }
        }
      }
    },
