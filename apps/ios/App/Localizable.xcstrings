          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Msimbo chanzo unaolingana na kila toleo ni tagi ya toleo hilo kwenye hazina iliyo hapa chini, ambayo inafunga matoleo ya vitegemezi vyote."
          }
        },
        "tk" : {
