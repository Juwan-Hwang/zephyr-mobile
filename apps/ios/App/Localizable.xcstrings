          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programu nyingine zinaweza kutumia sheria na mazingira ya Zephyr kupitia mlango huu kwenye 127.0.0.1."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beýleki programmalar 127.0.0.1-däki şu port arkaly Zephyr-iň düzgünlerini we ssenariýlerini ulanyp bilýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
