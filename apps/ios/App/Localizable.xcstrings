        }
      }
    },
    "图案由今天的流量生成，不含节点名称与 IP 地址。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنشأ النقش من حركة بيانات اليوم ولا يتضمن أسماء العقد أو عناوين IP."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pattern is generated from today’s traffic and contains no node names or IP addresses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El patrón se genera a partir del tráfico de hoy y no incluye nombres de nodos ni direcciones IP."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طرح از ترافیک امروز ساخته می‌شود و نام نودها یا نشانی‌های IP را در بر ندارد."
