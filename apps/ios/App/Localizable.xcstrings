    "%@节点均不可用时，%@ 将暂停。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم تتوفر أي عقدة %1$@، فسيتوقف %2$@ مؤقتًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If no %1$@ node is available, %2$@ will pause."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no hay nodos de %1$@ disponibles, %2$@ se pausará."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر هیچ نود %1$@ در دسترس نباشد، %2$@ متوقف می‌شود."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ノードがすべて利用できない場合、%2$@は一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능한 %1$@ 노드가 없으면 %2$@ 연결이 일시 정지됩니다."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ နုဒ် မရနိုင်ပါက %2$@ ခဏရပ်မည်။"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если нет доступных узлов %1$@, %2$@ приостановится."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikiwa hakuna nodi ya %1$@ inayopatikana, %2$@ itasitishwa."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiç bir %1$@ düwüni elýeterli bolmasa, %2$@ togtadylar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ düğümlerinin hiçbiri kullanılamazsa %2$@ duraklatılır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر کوئی %1$@ نوڈ دستیاب نہ ہو تو %2$@ رک جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu không còn nút %1$@ nào khả dụng, %2$@ sẽ tạm dừng."
          }
        }
      }
    },
    "%@节点均不可用时，将使用场景中的其他节点。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم تتوفر أي عقدة %@، فستُستخدم عقد أخرى في المشهد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If no %@ node is available, other nodes in the scene will be used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no hay nodos de %@ disponibles, se usarán otros nodos del escenario."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر هیچ نود %@ در دسترس نباشد، از نودهای دیگر صحنه استفاده می‌شود."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ノードがすべて利用できない場合は、シーン内のほかのノードを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능한 %@ 노드가 없으면 시나리오의 다른 노드를 사용합니다."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ နုဒ် မရနိုင်ပါက မြင်ကွင်းရှိ အခြား နုဒ်များကို သုံးမည်။"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если нет доступных узлов %@, будут использованы другие узлы сценария."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikiwa hakuna nodi ya %@ inayopatikana, nodi nyingine katika mazingira haya zitatumika."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiç bir %@ düwüni elýeterli bolmasa, ssenariýdäki beýleki düwünler ulanylar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ düğümlerinin hiçbiri kullanılamazsa senaryodaki diğer düğümler kullanılır."
