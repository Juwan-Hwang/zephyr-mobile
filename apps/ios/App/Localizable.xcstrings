    "重新生成后，其他 App 中填写的旧密码将失效。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد إعادة الإنشاء، ستتوقف كلمة المرور القديمة المُدخلة في التطبيقات الأخرى عن العمل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After regenerating, the old password entered in other apps will stop working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de regenerarla, la contraseña anterior introducida en otras apps dejará de funcionar."
