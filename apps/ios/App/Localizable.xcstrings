        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس از ساخت دوباره، گذرواژهٔ قبلی که در برنامه‌های دیگر وارد شده دیگر کار نمی‌کند."
          }
        },
        "ja" : {
          "stringUnit" : {
