        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생성하면 다른 앱에 입력한 이전 암호는 더 이상 작동하지 않습니다."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အသစ်ထုတ်ပြီးနောက် အခြားအက်ပ်များတွင် ထည့်ထားသော စကားဝှက်အဟောင်း အလုပ်မလုပ်တော့ပါ။"
