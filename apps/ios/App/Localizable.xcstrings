          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otras apps pueden usar las reglas y los escenarios de Zephyr a través de este puerto en 127.0.0.1."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه‌های دیگر می‌توانند از طریق این درگاه روی 127.0.0.1 از قوانین و صحنه‌های Zephyr استفاده کنند."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの App は、127.0.0.1 のこのポートを通じて Zephyr のルールとシーンを使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱은 127.0.0.1의 이 포트를 통해 Zephyr의 규칙과 시나리오를 사용할 수 있습니다."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အခြားအက်ပ်များသည် 127.0.0.1 ပေါ်ရှိ ဤပို့တ်မှတစ်ဆင့် Zephyr ၏ စည်းမျဉ်းများနှင့် မြင်ကွင်းများကို သုံးနိုင်သည်။"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
