            "value" : "AI၊ ဗီဒီယို စသည့် မြင်ကွင်းများကို ဤနေရာတွင် မြင်ရန် စာရင်းသွင်းမှု ထည့်ပါ။"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте подписку, и здесь появятся сценарии, например AI и «Видео»."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeza usajili ili uone mazingira kama AI na Video hapa."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI we Wideo ýaly ssenariýleri şu ýerde görmek üçin abuna goşuň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI ve Video gibi senaryoları burada görmek için bir abonelik ekleyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI اور ویڈیو جیسے مناظر یہاں دیکھنے کے لیے سبسکرپشن شامل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm đăng ký để xem các ngữ cảnh như AI và Video tại đây."
          }
        }
      }
