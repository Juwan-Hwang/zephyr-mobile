    "核心意外退出，已自动重启" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقفت النواة بشكل غير متوقع وأُعيد تشغيلها"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The core quit unexpectedly and was restarted"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El núcleo se ha cerrado inesperadamente y se ha reiniciado"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هسته به‌طور غیرمنتظره بسته شد و دوباره راه‌اندازی شد"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コアが予期せず終了したため、再起動しました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코어가 예기치 않게 종료되어 재시작했습니다"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပင်မစနစ် မမျှော်လင့်ဘဲ ရပ်သွားသဖြင့် ပြန်စတင်ပြီး"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ядро неожиданно завершило работу и было перезапущено"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiini kilifungwa ghafla na kimewashwa upya"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýadro garaşylmadyk ýagdaýda ýapyldy we täzeden işledildi"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çekirdek beklenmedik şekilde kapandı ve yeniden başlatıldı"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کور غیر متوقع طور پر بند ہو گیا اور دوبارہ شروع کر دیا گیا"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lõi đã thoát đột ngột và được khởi động lại"
          }
        }
      }
    },
