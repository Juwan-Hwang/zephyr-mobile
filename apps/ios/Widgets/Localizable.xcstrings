    "在规则、全局、直连之间切换 Zephyr 的代理模式。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدّل وضع الوكيل في Zephyr بين القاعدة والشامل والمباشر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switches Zephyr’s proxy mode between Rule, Global, and Direct."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el modo de proxy de Zephyr entre Regla, Global y Directo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حالت پروکسی Zephyr را بین قانون، سراسری و مستقیم تغییر می‌دهد."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zephyr のプロキシモードをルール、グローバル、ダイレクトの間で切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zephyr의 프록시 모드를 규칙, 글로벌, 다이렉트 간에 전환합니다."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zephyr ၏ ပရောက်စီ မုဒ်ကို စည်းမျဉ်း၊ ကမ္ဘာလုံးဆိုင်ရာ နှင့် တိုက်ရိုက် ကြား ပြောင်းသည်။"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключает режим прокси Zephyr: «Правило», «Глобальный» или «Прямой»."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubadilisha hali ya proksi ya Zephyr kati ya Sheria, Jumla na Moja kwa Moja."
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zephyr-iň proksi režimini Düzgün, Global we Göni arasynda çalyşýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zephyr’in proxy modunu Kural, Küresel ve Doğrudan arasında değiştirir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zephyr کا پراکسی موڈ قاعدہ، گلوبل اور براہ راست کے درمیان تبدیل کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển chế độ proxy của Zephyr giữa Quy tắc, Toàn cục và Trực tiếp."
          }
        }
      }
    },
    "在锁屏上查看速率与场景。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض السرعة والمشاهد على شاشة القفل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See speed and scenes on the Lock Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta la velocidad y los escenarios en la pantalla de bloqueo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سرعت و صحنه‌ها را روی صفحهٔ قفل ببینید."
          }
        },
        "ja" : {
          "stringUnit" : {
