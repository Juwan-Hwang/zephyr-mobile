          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic connection is paused. Open Zephyr to connect manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión automática está en pausa. Abre Zephyr para conectarte manualmente."
