        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အလိုအလျောက် ချိတ်ဆက်မှုကို ခေတ္တရပ်ထားသည်။ Zephyr ကိုဖွင့်ပြီး ကိုယ်တိုင် ချိတ်ဆက်ပါ။"
          }
