--- a/pkg/tcpip/link/fdbased/endpoint.go
+++ b/pkg/tcpip/link/fdbased/endpoint.go
@@ -474,6 +474,12 @@
 func IsSocketFD(fd int) (bool, error) {
 	var stat unix.Stat_t
 	if err := unix.Fstat(fd, &stat); err != nil {
+		// Zephyr/OHOS: the system VPN hands the app a TUN fd that SELinux does not
+		// allow the app domain to fstat. A denied fstat therefore means "not a
+		// socket" (TUN character device), which is the only fd type we pass here.
+		if err == unix.EACCES || err == unix.EPERM {
+			return false, nil
+		}
 		return false, fmt.Errorf("unix.Fstat(%v,...) failed: %v", fd, err)
 	}
 	return (stat.Mode & unix.S_IFSOCK) == unix.S_IFSOCK, nil
