<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zephyr" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/zephyr_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowSplashScreenBackground">@color/zephyr_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/zephyr_icon_bg</item>
    </style>
</resources>
